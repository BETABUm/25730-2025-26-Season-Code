package org.firstinspires.ftc.teamcode;

import com.qualcomm.robotcore.eventloop.opmode.Autonomous;
import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.hardware.CRServo;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.Servo;
import com.qualcomm.robotcore.hardware.ServoController;
import com.qualcomm.robotcore.hardware.TouchSensor;
import com.qualcomm.robotcore.util.ElapsedTime;

@Autonomous(name = "FinalAuto (Blocks to Java)", preselectTeleOp = "Final Code")
public class FinalAuto extends LinearOpMode {

  private ServoController ExpansionHub2_ServoController;
  private ServoController ControlHub_ServoController;
  private CRServo scissorLift;
  private CRServo chainBeltLeft;
  private CRServo chainBeltRight;
  private Servo andyBecauseItMakesBuckets;
  private DcMotor FrontRight;
  private DcMotor FrontLeft;
  private DcMotor BackLeft;
  private DcMotor BackRight;
  private DcMotor intakeMotor;
  private TouchSensor touchSensor;
  private DcMotor linearSliderLeft;
  private DcMotor linearSliderRight;
  private CRServo scissorLift1;

  ElapsedTime runtime;

  /**
   * This sample contains the bare minimum Blocks for any regular OpMode. The 3 blue
   * Comment Blocks show where to place Initialization code (runs once, after touching the
   * DS INIT button, and before touching the DS Start arrow), Run code (runs once, after
   * touching Start), and Loop code (runs repeatedly while the OpMode is active, namely not
   * Stopped).
   */
  @Override
  public void runOpMode() {
    ExpansionHub2_ServoController = hardwareMap.get(ServoController.class, "Expansion Hub 2");
    ControlHub_ServoController = hardwareMap.get(ServoController.class, "Control Hub");
    scissorLift = hardwareMap.get(CRServo.class, "scissorLiftAsCRServo");
    chainBeltLeft = hardwareMap.get(CRServo.class, "chainBeltLeftAsCRServo");
    chainBeltRight = hardwareMap.get(CRServo.class, "chainBeltRightAsCRServo");
    andyBecauseItMakesBuckets = hardwareMap.get(Servo.class, "andyBecauseItMakesBucketsAsServo");
    FrontRight = hardwareMap.get(DcMotor.class, "FrontRightAsDcMotor");
    FrontLeft = hardwareMap.get(DcMotor.class, "FrontLeftAsDcMotor");
    BackLeft = hardwareMap.get(DcMotor.class, "BackLeftAsDcMotor");
    BackRight = hardwareMap.get(DcMotor.class, "BackRightAsDcMotor");
    intakeMotor = hardwareMap.get(DcMotor.class, "intakeMotorAsDcMotor");
    touchSensor = hardwareMap.get(TouchSensor.class, "touchSensorAsTouchSensor");
    linearSliderLeft = hardwareMap.get(DcMotor.class, "linearSliderLeftAsDcMotor");
    linearSliderRight = hardwareMap.get(DcMotor.class, "linearSliderRightAsDcMotor");
    scissorLift1 = hardwareMap.get(CRServo.class, "scissorLift1AsCRServo");

    // QUESTION MARKS EXPLAIN THE FUNCTIONS
    // Put initialization blocks here.
    ExpansionHub2_ServoController.pwmEnable();
    ControlHub_ServoController.pwmEnable();
    scissorLift.setPwmEnable();
    chainBeltLeft.setPwmEnable();
    chainBeltRight.setPwmEnable();
    andyBecauseItMakesBuckets.setPwmEnable();
    waitForStart();
    if (opModeIsActive()) {
      // Whatever goes in here runs once
      driveStrafe(false, true, 1550, 1);
      driveTurn(true, true, 350, 0.5);
      setLinearSliderPowerDirectionPos(1, 450, -450);
      sleep(1000);
      setChainBeltPower_Direction_Time(0.65, 0.2, true);
      setChainBeltPower_Direction_Time(0.05, 1.2, false);
      setScissorLiftPowerDirectionTime(3.5, true, 0.89);
      sleep(1000);
      bucketPos(0);
      sleep(1000);
      setScissorLiftPowerDirectionTime(3.5, false, 0.89);
      driveTurn(true, false, 500, 0.5);
      driveStrafe(true, true, 200, 1);
      foward_Back(true, true, 400, 0.4);
      setIntakePowerPos(1, 1000);
      setLinearSliderPowerDirectionPos(1, -500, 500);
      setChainBeltPower_Direction_Time(0.89, 0.2, false);
      while (opModeIsActive()) {
        printStatements();
        timer();
      }
    }
  }

  /**
   * Describe this function...
   */
  private void timer() {
    runtime = new ElapsedTime();
  }

  /**
   * Describe this function...
   */
  private void foward_Back(boolean fowardfoward, boolean foward, int targetPosDrive, double driveSpeedFoward_Back) {
    FrontRight.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    FrontLeft.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    BackLeft.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    BackRight.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    if (fowardfoward) {
      FrontLeft.setTargetPosition(targetPosDrive);
      FrontRight.setTargetPosition(-targetPosDrive);
      BackLeft.setTargetPosition(targetPosDrive);
      BackRight.setTargetPosition(targetPosDrive);
    } else {
      FrontLeft.setTargetPosition(-targetPosDrive);
      FrontRight.setTargetPosition(targetPosDrive);
      BackLeft.setTargetPosition(-targetPosDrive);
      BackRight.setTargetPosition(-targetPosDrive);
    }
    FrontLeft.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    FrontRight.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    BackLeft.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    BackRight.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    while (foward) {
      // foward true = foward
      BackLeft.setPower(driveSpeedFoward_Back);
      FrontLeft.setPower(driveSpeedFoward_Back);
      BackRight.setPower(driveSpeedFoward_Back);
      FrontRight.setPower(driveSpeedFoward_Back);
      if (BackLeft.getCurrentPosition() == BackLeft.getTargetPosition() || BackRight.getCurrentPosition() == BackRight.getTargetPosition() || FrontLeft.getCurrentPosition() == FrontLeft.getTargetPosition() || FrontRight.getCurrentPosition() == FrontRight.getTargetPosition()) {
        foward = false;
      }
    }
  }

  /**
   * Describe this function...
   */
  private void printStatements() {
    telemetry.addData("Front Left", FrontLeft.getPower());
    telemetry.addData("Back Left", BackLeft.getPower());
    telemetry.addData("Front Right", FrontRight.getPower());
    telemetry.addData("Back Right", BackRight.getPower());
    telemetry.update();
  }

  /**
   * Describe this function...
   */
  private void driveTurn(boolean turn, boolean turnturn, int targetPosTurn, double driveSpeedTurn) {
    telemetry.addLine("sigma");
    FrontRight.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    FrontLeft.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    BackLeft.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    BackRight.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    if (turnturn) {
      FrontRight.setTargetPosition(targetPosTurn);
      FrontLeft.setTargetPosition(targetPosTurn);
      BackRight.setTargetPosition(-targetPosTurn);
      BackLeft.setTargetPosition(targetPosTurn);
    } else {
      FrontLeft.setTargetPosition(-targetPosTurn);
      FrontRight.setTargetPosition(-targetPosTurn);
      BackRight.setTargetPosition(targetPosTurn);
      BackLeft.setTargetPosition(-targetPosTurn);
    }
    FrontLeft.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    FrontRight.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    BackLeft.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    BackRight.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    // turn true = clockwise rotation
    while (turn) {
      BackLeft.setPower(driveSpeedTurn);
      FrontLeft.setPower(driveSpeedTurn);
      BackRight.setPower(driveSpeedTurn);
      FrontRight.setPower(driveSpeedTurn);
      if (BackLeft.getCurrentPosition() <= BackLeft.getTargetPosition() || BackRight.getCurrentPosition() == BackRight.getTargetPosition() || FrontLeft.getCurrentPosition() == FrontLeft.getTargetPosition() || FrontRight.getCurrentPosition() == FrontRight.getTargetPosition()) {
        turn = false;
      }
    }
  }

  /**
   * Describe this function...
   */
  private void driveStrafe(boolean strafestrafe, boolean strafe, int targetPosStrafe, int driveSpeedStrafe) {
    FrontRight.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    FrontLeft.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    BackLeft.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    BackRight.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    if (strafestrafe) {
      FrontRight.setTargetPosition(targetPosStrafe);
      FrontLeft.setTargetPosition(targetPosStrafe);
      BackRight.setTargetPosition(targetPosStrafe);
      BackLeft.setTargetPosition(-targetPosStrafe);
    } else {
      FrontLeft.setTargetPosition(-targetPosStrafe);
      FrontRight.setTargetPosition(-targetPosStrafe);
      BackRight.setTargetPosition(-targetPosStrafe);
      BackLeft.setTargetPosition(targetPosStrafe);
    }
    FrontLeft.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    FrontRight.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    BackLeft.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    BackRight.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    // true strafe = strafe right
    while (strafe) {
      FrontRight.setPower(driveSpeedStrafe);
      BackLeft.setPower(driveSpeedStrafe);
      FrontLeft.setPower(driveSpeedStrafe);
      BackRight.setPower(driveSpeedStrafe);
      if (BackLeft.getCurrentPosition() == BackLeft.getTargetPosition() || BackRight.getCurrentPosition() == BackRight.getTargetPosition() || FrontLeft.getCurrentPosition() == FrontLeft.getTargetPosition() || FrontRight.getCurrentPosition() == FrontRight.getTargetPosition()) {
        strafe = false;
      }
    }
  }

  /**
   * Describe this function...
   */
  private void setChainBeltPower_Direction_Time(double chainBeltPower, double chainBeltTime, boolean chainBeltDirection) {
    runtime.reset();
    while (runtime.seconds() <= chainBeltTime) {
      chainBeltLeft.setPower(chainBeltPower);
      chainBeltRight.setPower(chainBeltPower);
      if (chainBeltDirection) {
        chainBeltLeft.setDirection(CRServo.Direction.FORWARD);
        chainBeltRight.setDirection(CRServo.Direction.REVERSE);
      } else {
        chainBeltLeft.setDirection(CRServo.Direction.REVERSE);
        chainBeltRight.setDirection(CRServo.Direction.FORWARD);
      }
    }
  }

  /**
   * Describe this function...
   */
  private void setIntakePowerPos(int intakePower, int intakePosition) {
    intakeMotor.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    intakeMotor.setTargetPosition(intakePosition);
    intakeMotor.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    while (touchSensor.isPressed() == false) {
      intakeMotor.setPower(intakePower);
    }
  }

  /**
   * Describe this function...
   */
  private void setLinearSliderPowerDirectionPos(int linearSliderPower, int linearSliderTargetRight, int linearSliderTargetLEft) {
    linearSliderLeft.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    linearSliderRight.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    linearSliderLeft.setTargetPosition(linearSliderTargetLEft);
    linearSliderRight.setTargetPosition(linearSliderTargetRight);
    linearSliderLeft.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    linearSliderRight.setMode(DcMotor.RunMode.RUN_TO_POSITION);
    linearSliderLeft.setPower(linearSliderPower);
    linearSliderRight.setPower(linearSliderPower);
  }

  /**
   * Describe this function...
   */
  private void setScissorLiftPowerDirectionTime(double scissorLiftTime, boolean scissorLiftDirection, double liftPower) {
    runtime.reset();
    while (runtime.seconds() <= scissorLiftTime) {
      scissorLift.setPower(liftPower);
      scissorLift1.setPower(liftPower);
      if (scissorLiftDirection) {
        scissorLift.setDirection(CRServo.Direction.REVERSE);
        scissorLift1.setDirection(CRServo.Direction.FORWARD);
      } else {
        scissorLift.setDirection(CRServo.Direction.FORWARD);
        scissorLift1.setDirection(CRServo.Direction.REVERSE);
      }
    }
  }

  /**
   * Describe this function...
   */
  private void bucketDirectionPosTime(
      // TODO: Enter the type for argument named bucketGYATTime
      UNKNOWN_TYPE bucketGYATTime,
      double position, boolean bucketDirection) {
    runtime.reset();
    while (runtime.seconds() <= bucketGYATTime) {
      if (bucketDirection) {
        andyBecauseItMakesBuckets.setDirection(Servo.Direction.FORWARD);
      } else {
        andyBecauseItMakesBuckets.setDirection(Servo.Direction.REVERSE);
      }
      andyBecauseItMakesBuckets.setPosition(position);
    }
  }

  /**
   * Describe this function...
   */
  private void checkIntake() {
    if (intakeMotor.isBusy() && Math.abs(BackLeft.getCurrentPosition() - BackLeft.getTargetPosition()) <= 10) {
      stopIntake();
    }
  }

  /**
   * Describe this function...
   */
  private void setChainBeltPower(int chainBeltPower) {
    chainBeltLeft.setPower(chainBeltPower);
    chainBeltRight.setPower(chainBeltPower);
  }

  /**
   * Describe this function...
   */
  private void setIntakePower(int intakePower) {
    intakeMotor.setPower(intakePower);
  }

  /**
   * Describe this function...
   */
  private void setLinearSliderPowe(int linearSliderPower) {
    linearSliderLeft.setPower(linearSliderPower);
    linearSliderRight.setPower(linearSliderPower);
  }

  /**
   * Describe this function...
   */
  private void stopChainBelt() {
    setChainBeltPower(0);
  }

  /**
   * Describe this function...
   */
  private void stopIntake() {
    setIntakePower(0);
  }

  /**
   * Describe this function...
   */
  private void bucketPos(int position) {
    andyBecauseItMakesBuckets.setPosition(position);
  }

  /**
   * Describe this function...
   */
  private void setScissorLiftPower(int liftPower) {
    scissorLift.setPower(liftPower);
    scissorLift1.setPower(liftPower);
  }

  /**
   * Describe this function...
   */
  private void stopLinearSliders() {
    setLinearSliderPowe(0);
  }

  /**
   * Describe this function...
   */
  private void stopScissorLift() {
    setScissorLiftPower(0);
  }

  /**
   * Describe this function...
   */
  private void bucketBack() {
    bucketPos(1);
  }
}