setChainBeltPower_Direction_Time(0.05, 1.2, false);
telemetry.addData("Done with out", "true");
}
}

/**
* Describe this function...
*/
private void setChainBeltPower_Direction(double chainBeltPower, boolean chainBeltDirection) {
chainBeltLeft.setPower(chainBeltPower);
chainBeltRight.setPower(chainBeltPower);
if (chainBeltDirection) {
chainBeltLeft.setDirection(CRServo.Direction.REVERSE);
chainBeltRight.setDirection(CRServo.Direction.FORWARD);
} else {
chainBeltLeft.setDirection(CRServo.Direction.FORWARD);
chainBeltRight.setDirection(CRServo.Direction.REVERSE);
}
}

/**
* Describe this function...
*/
private void setIntakePower_Direction(int intakePower, boolean intakeDirection) {
intakeMotor.setPower(intakePower);
if (intakeDirection == true) {
intakeMotor.setDirection(DcMotor.Direction.FORWARD);
} else {
intakeMotor.setDirection(DcMotor.Direction.REVERSE);
}
}

/**
* Describe this function...
*/
