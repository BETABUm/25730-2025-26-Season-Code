}

/**
* Describe this function...
*/
private void checkIntake() {
if (intakeMotor.isBusy() && intakeMotor.getCurrentPosition() - intakeMotor.getTargetPosition() < 10) {
stopIntake();
}
}

/**
* Describe this function...
*/
private void intakeOut() {
if (gamepad1.a) {
setLinearSliderPowerDirectionPos(0.7, 730, -730);
