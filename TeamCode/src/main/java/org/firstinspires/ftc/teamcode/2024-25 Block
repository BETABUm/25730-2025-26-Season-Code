/**
* Describe this function...
*/
private void intake() {
if (gamepad1.right_trigger >= 0.69 || gamepad1.left_trigger >= 0.69) {
intakeMotor.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
if (touchSensor.isPressed()) {
stopIntake();
} else if (gamepad1.right_trigger >= 0.69) {
setIntakePower_Direction(1, true);
} else if (gamepad1.left_trigger >= 0.69) {
setIntakePower_Direction(1, false);
}
}
}

/**
* Describe this function...
*/
private void chainBeltBackStart() {
